
<div class="container mt-5 mb-5">

    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- بطاقة النتيجة -->
            <div class="card shadow-lg border-0">

                <!-- العنوان -->
                <div class="card-header text-center py-4">
                    <h2 class="mb-2">نتيجة الامتحان</h2>
                    <p class="text-muted mb-0">
                        تم تسليم الامتحان بنجاح
                    </p>
                </div>

                <div class="card-body p-4">

                    <!-- بيانات الطالب -->
                    <div class="text-center mb-4">

                        <p class="mb-1">
                            اسم الطالب:
                            <strong>{{attempt.studentName}}</strong>
                        </p>

                        <p class="mb-1">
                            الامتحان:
                            <strong>{{attempt.exam.title}}</strong>
                        </p>

                        <p class="mb-0">
                            المادة:
                            <strong>{{attempt.exam.subject}}</strong>
                        </p>

                        <p class="mb-0">
                            الصف:
                            <strong>{{attempt.exam.grade}}</strong>
                        </p>

                        <p class="mb-0">
                            السنة:
                            <strong>{{attempt.exam.academicYear}}</strong>
                        </p>

                        <p class="mb-0">
                            نوع الاختبار:
                            <strong>{{attempt.exam.examType}}</strong>
                        </p>

                    </div>

                    <hr>

                    <!-- النتيجة الرئيسية -->
                    <div class="text-center my-4">

                        <p class="text-muted mb-2">
                            الدرجة النهائية
                        </p>

                        <h1 class="display-3 fw-bold mb-2">
                            {{attempt.score}}
                            /
                            {{attempt.exam.totalMarks}}
                        </h1>

                        {{#ifEquals attempt.status 'pending'}}

                            <div class="alert alert-warning text-center mt-3">
                                ⏳ النتيجة غير نهائية
                                <br>
                                يوجد أسئلة تحتاج إلى تصحيح المدرس.
                            </div>

                        {{else}}

                            <div class="alert alert-success text-center mt-3">
                                ✓ تم تصحيح الامتحان بالكامل
                            </div>

                        {{/ifEquals}}

                        <!-- النسبة -->
                        <h3 class="mb-3">
                            {{percentage}}%
                        </h3>

                        <!-- حالة الطالب -->
                        {{#if passed}}

                            <span class="badge bg-success fs-5 px-4 py-2">
                                ناجح ✓
                            </span>

                        {{else}}

                            <span class="badge bg-danger fs-5 px-4 py-2">
                                راسب ✕
                            </span>

                        {{/if}}

                    </div>

                    <!-- شريط النسبة -->
                    <div class="mb-4">

                        <div class="progress" style="height: 20px;">

                            <div
                                class="progress-bar {{#if passed}}bg-success{{else}}bg-danger{{/if}}"
                                role="progressbar"
                                style="width: {{percentage}}%;"
                            >
                                {{percentage}}%
                            </div>

                        </div>

                    </div>

                    <!-- ملاحظة -->
                    <div class="alert alert-info text-center">
                        تم احتساب النتيجة تلقائيًا للأسئلة الموضوعية.
                    </div>

                    <hr class="my-4">

                    <!-- تفاصيل الأسئلة -->
                    <h4 class="text-center mb-4">
                        تفاصيل الإجابات
                    </h4>

                    {{#if questionGroups.length}}

                        {{#each questionGroups}}

                            <!-- عنوان المجموعة -->
                            <h5 class="mb-3">
                                السؤال
                                {{arabicNumber this.groupNumber}}
                                :
                                {{this.title}}
                            </h5>

                            {{#each this.questions}}

                                <!-- ================================= -->
                                <!-- سؤال التصويب -->
                                <!-- ================================= -->

                                {{#ifEquals question.type 'correction'}}

                                    <div class="card mb-4 border">
                                        <div class="card-body">

                                            <!-- نص السؤال -->
                                            <div class="mb-3">
                                                <strong>
                                                    <p class="mt-3 mb-2">
                                                        {{question.order}} -

                                                        <span
                                                            class="correction-question"
                                                            data-question-text="{{question.questionText}}"
                                                            data-underlined-text="{{question.underlinedText}}"
                                                        >
                                                            <span class="question-text">
                                                                {{question.questionText}}
                                                            </span>
                                                        </span>
                                                    </p>
                                                </strong>
                                            </div>

                                            <!-- إجابة الطالب -->
                                            <div class="alert alert-light border py-2 px-3 mb-2">
                                                <strong>إجابة الطالب:</strong>

                                                {{#if studentAnswer.text}}
                                                    {{studentAnswer.text}}
                                                {{else}}
                                                    <span class="text-muted">
                                                        لم يتم الإجابة
                                                    </span>
                                                {{/if}}
                                            </div>

                                            <!-- نتيجة السؤال -->
                                            {{#ifEquals status 'correct'}}

                                                <div class="alert alert-success py-2 px-3 mb-0">
                                                    ✓ إجابة صحيحة

                                                    <span class="ms-3">
                                                        <strong>
                                                            {{marks}}
                                                            /
                                                            {{question.marks}}
                                                            درجة
                                                        </strong>
                                                    </span>
                                                </div>

                                            {{else}}

                                                <div class="alert alert-danger py-2 px-3 mb-0">
                                                    ✕ إجابة خاطئة

                                                    <span class="ms-3">
                                                        - الإجابة الصحيحة:
                                                        {{question.correctAnswer}}
                                                    </span>

                                                    <span class="ms-3">
                                                        <strong>
                                                            {{marks}}
                                                            /
                                                            {{question.marks}}
                                                            درجة
                                                        </strong>
                                                    </span>
                                                </div>

                                            {{/ifEquals}}

                                        </div>
                                    </div>

                                {{else}}

                                    <!-- ================================= -->
                                    <!-- سؤال الرسم -->
                                    <!-- ================================= -->

                                    {{#ifEquals question.type 'drawing'}}

                                        <div class="card mb-3 border">
                                            <div class="card-body py-2 px-3">

                                                <!-- السؤال -->
                                                <div class="mb-2">
                                                    <strong>
                                                        {{question.order}} -
                                                        {{question.questionText}}
                                                    </strong>
                                                </div>

                                                <!-- صورة السؤال -->
                                                {{#if question.drawingImage}}

                                                    <div class="mb-3">
                                                        <img
                                                            src="{{question.drawingImage}}"
                                                            class="img-fluid rounded border"
                                                            alt="صورة سؤال الرسم"
                                                            style="
                                                                max-width: 350px;
                                                                max-height: 250px;
                                                                display: block;
                                                            "
                                                        >
                                                    </div>

                                                {{/if}}

                                                <!-- إجابة الطالب النصية -->
                                                {{#ifEquals question.answerMode 'text'}}

                                                    <div class="mb-2">
                                                        <strong>إجابة الطالب:</strong>

                                                        {{#if studentAnswer.text}}
                                                            {{studentAnswer.text}}
                                                        {{else}}
                                                            <span class="text-muted">
                                                                لم يتم الإجابة عن الجزء النصي
                                                            </span>
                                                        {{/if}}
                                                    </div>

                                                {{/ifEquals}}

                                                <!-- النص + الرسم -->
                                                {{#ifEquals question.answerMode 'both'}}

                                                    <div class="mb-2">
                                                        <strong>إجابة الطالب:</strong>

                                                        {{#if studentAnswer.text}}
                                                            {{studentAnswer.text}}
                                                        {{else}}
                                                            <span class="text-muted">
                                                                لم يتم الإجابة عن الجزء النصي
                                                            </span>
                                                        {{/if}}
                                                    </div>

                                                {{/ifEquals}}

                                                <!-- رسم الطالب -->
                                                {{#if studentAnswer.drawing}}

                                                    <div class="mb-2">
                                                        <strong>رسم الطالب:</strong>

                                                        <div class="mt-1">
                                                            <img
                                                                src="{{studentAnswer.drawing}}"
                                                                class="img-fluid rounded border"
                                                                alt="رسم الطالب"
                                                                style="
                                                                    max-width: 350px;
                                                                    max-height: 250px;
                                                                    display: block;
                                                                "
                                                            >
                                                        </div>
                                                    </div>

                                                {{/if}}

                                                <!-- لا توجد إجابة -->
                                                {{#unless studentAnswer.text}}

                                                    {{#unless studentAnswer.drawing}}

                                                        <div class="text-muted mb-2">
                                                            لم يتم الإجابة عن السؤال
                                                        </div>

                                                    {{/unless}}

                                                {{/unless}}

                                                <!-- نتيجة التصحيح -->
                                                {{#ifEquals status 'pending'}}

                                                    <div class="alert alert-warning py-1 px-2 mb-0">
                                                        ⏳ في انتظار تصحيح المدرس
                                                    </div>

                                                {{else}}

                                                    {{#ifEquals marks 0}}

                                                        <div class="alert alert-danger py-1 px-2 mb-0">
                                                            ✕ تصحيح المدرس

                                                            <span class="ms-3">
                                                                <strong>
                                                                    {{marks}}
                                                                    /
                                                                    {{question.marks}}
                                                                    درجة
                                                                </strong>
                                                            </span>
                                                        </div>

                                                    {{else}}

                                                        <div class="alert alert-success py-1 px-2 mb-0">
                                                            ✓ تصحيح المدرس

                                                            <span class="ms-3">
                                                                <strong>
                                                                    {{marks}}
                                                                    /
                                                                    {{question.marks}}
                                                                    درجة
                                                                </strong>
                                                            </span>
                                                        </div>

                                                    {{/ifEquals}}

                                                {{/ifEquals}}

                                            </div>
                                        </div>

                                    {{else}}

                                        <!-- ================================= -->
                                        <!-- باقي أنواع الأسئلة -->
                                        <!-- ================================= -->

                                        <div class="card mb-4 border">
                                            <div class="card-body">

                                                <!-- السؤال -->
                                                <div class="mb-3">
                                                    <strong>
                                                        <p class="mt-3 mb-2">
                                                            {{question.order}} -
                                                            {{question.questionText}}
                                                        </p>
                                                    </strong>
                                                </div>

                                                <!-- إجابة الطالب -->
                                                <div class="alert alert-light border py-2 px-3 mb-2">
                                                    <strong>إجابة الطالب:</strong>

                                                    {{#if studentAnswer.text}}
                                                        {{studentAnswer.text}}
                                                    {{else}}
                                                        <span class="text-muted">
                                                            لم يتم الإجابة
                                                        </span>
                                                    {{/if}}
                                                </div>

                                                <!-- ================================= -->
                                                <!-- الأسئلة المقالية -->
                                                <!-- ================================= -->

                                                {{#ifEquals question.type 'essay'}}

                                                    <!-- الإجابة النموذجية -->
                                                    

                                                            <div class="alert alert-success py-2 px-3 mb-2">

                                                                <div class="model-answer-title">
                                                                    الإجابة النموذجية:
                                                                </div>

                                                                <div class="model-answer-text">
                                                                    {{#if question.modelAnswer}}
                                                                        {{question.modelAnswer}}
                                                                    {{else}}
                                                                        لم يتم تسجيل إجابة نموذجية لهذا السؤال.
                                                                    {{/if}}
                                                                </div>

                                                            </div>


                                                    <!-- حالة التصحيح -->
                                                    {{#ifEquals status 'pending'}}

                                                        <div class="alert alert-warning py-2 px-3 mb-0">
                                                            ⏳ في انتظار تصحيح المدرس
                                                        </div>

                                                    {{else}}

                                                        <div class="alert alert-info py-2 px-3 mb-0">

                                                            <strong>
                                                                تصحيح المدرس:
                                                            </strong>

                                                            <span class="ms-3">
                                                                {{marks}}
                                                                /
                                                                {{question.marks}}
                                                                درجة
                                                            </span>

                                                        </div>

                                                    {{/ifEquals}}

                                                {{else}}

                                                    <!-- ================================= -->
                                                    <!-- الأسئلة التي يتم تصحيحها تلقائيًا -->
                                                    <!-- ================================= -->

                                                    {{#ifEquals status 'correct'}}

                                                        <div class="alert alert-success py-2 px-3 mb-0">
                                                            ✓ إجابة صحيحة

                                                            <span class="ms-3">
                                                                <strong>
                                                                    {{marks}}
                                                                    /
                                                                    {{question.marks}}
                                                                    درجة
                                                                </strong>
                                                            </span>
                                                        </div>

                                                    {{else}}

                                                        <div class="alert alert-danger py-2 px-3 mb-0">
                                                            ✕ إجابة خاطئة

                                                            <span class="ms-3">
                                                                - الإجابة الصحيحة:
                                                                {{question.correctAnswer}}
                                                            </span>

                                                            <span class="ms-3">
                                                                <strong>
                                                                    {{marks}}
                                                                    /
                                                                    {{question.marks}}
                                                                    درجة
                                                                </strong>
                                                            </span>
                                                        </div>

                                                    {{/ifEquals}}

                                                {{/ifEquals}}

                                            </div>
                                        </div>

                                    {{/ifEquals}}

                                {{/ifEquals}}

                            {{/each}}

                        {{/each}}

                    {{else}}

                        <div class="alert alert-secondary text-center">
                            لا توجد تفاصيل متاحة للإجابات.
                        </div>

                    {{/if}}


                    
<!-- ===================================== -->
<!-- بيانات المدرس والتوقيع -->
<!-- ===================================== -->

<!-- ===================================== -->

<div class="text-center mt-5 mb-4">

    <div class="mb-2">

        <strong>
            المدرس:
        </strong>

        {{attempt.exam.teacherName}}

    </div>

    <div class="mb-3">

        <strong>
            رقم التليفون:
        </strong>

        {{attempt.exam.teacherPhone}}

    </div>

    <div class="mt-4">

        <strong>
            توقيع المدرس:
        </strong>

        <div
            style="
                width: 220px;
                height: 70px;
                border-bottom: 1px solid #000;
                margin: 10px auto 0;
            "
        >
        </div>

    </div>

</div>



            <!-- زر الطباعة -->
                    <div class="text-center mt-4 no-print">
                        <button
                            type="button"
                            class="btn btn-primary"
                            onclick="window.print()">
                            🖨️ طباعة النتيجة
                        </button>
                    </div>

                </div>
            </div>

        </div>
    </div>

</div>

<!-- ===================================== -->
<!-- تنسيق التصويب والإجابة النموذجية -->
<!-- ===================================== -->

<style>
.correction-underline {
    position: relative;
    display: inline-block;
}

.correction-underline::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    top: calc(100% + 10px);
    height: 3px;
    background-color: black;
}

/* الحفاظ على تنسيق الإجابة النموذجية */


<div
    class="alert alert-success mb-2"
    style="
        padding: 8px 12px;
        text-align: right;
        direction: rtl;
    "
>

    <div
        style="
            font-weight: bold;
            margin-bottom: 4px;
            text-align: right;
        "
    >
        الإجابة النموذجية:
    </div>

    <div
        style="
            margin: 0;
            padding: 0;
            text-align: right;
            direction: rtl;
            white-space: normal;
            line-height: 1.6;
        "
    >

        {{#if question.modelAnswer}}

            {{question.modelAnswer}}

        {{else}}

            لم يتم تسجيل إجابة نموذجية لهذا السؤال.

        {{/if}}

    </div>

</div>

@media print {

    .no-print {
        display: none !important;
        visibility: hidden !important;
    }

    .navbar {
        display: none !important;
    }

    body {
        background: white !important;
    }

    .card {
        box-shadow: none !important;
        border: 1px solid #ddd !important;
    }

    .alert {
        border: 1px solid #ddd !important;
    }

}



</style>

<!-- ===================================== -->
<!-- JavaScript  -->
<!-- ===================================== -->

<script>
document.addEventListener('DOMContentLoaded', function () {

    const correctionQuestions =
        document.querySelectorAll('.correction-question');

    correctionQuestions.forEach(function (questionElement) {

        const questionText =
            questionElement.dataset.questionText || '';

        const underlinedText =
            questionElement.dataset.underlinedText || '';

        const textContainer =
            questionElement.querySelector('.question-text');

        if (!textContainer || !underlinedText) {
            return;
        }

        const index =
            questionText.indexOf(underlinedText);

        if (index === -1) {
            return;
        }

        textContainer.innerHTML = '';

        textContainer.appendChild(
            document.createTextNode(
                questionText.substring(0, index)
            )
        );

        const underline =
            document.createElement('span');

        underline.textContent =
            underlinedText;

        underline.className =
            'correction-underline';

        textContainer.appendChild(underline);

        textContainer.appendChild(
            document.createTextNode(
                questionText.substring(
                    index + underlinedText.length
                )
            )
        );

    });

});
</script>

