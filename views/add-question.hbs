{{!-- صفحة إضافة / تعديل سؤال --}}

<div class="row justify-content-center">
    <div class="col-lg-9">

        <div class="card shadow-sm">

            <div class="card-header text-center">

                <h4 class="mb-1">

                    {{#if question}}
                        تعديل السؤال
                    {{else}}
                        إضافة سؤال
                    {{/if}}

                </h4>

                <small class="text-muted">

                    {{#if question}}
                        تعديل بيانات السؤال
                    {{else}}
                        أضف سؤالًا جديدًا إلى الامتحان
                    {{/if}}

                </small>

            </div>


            <div class="card-body">

                <form
                    action="/questions/add/{{exam._id}}"
                    method="post"
                    id="questionForm"
                    data-question-id="{{question._id}}"
                    data-drawing-image="{{question.drawingImage}}">


                    <!-- ========================= -->
                    <!-- نوع السؤال -->
                    <!-- ========================= -->

                    <div class="mb-4">

                        <label class="form-label">
                            نوع السؤال
                        </label>

                        <select
                            id="questionType"
                            name="type"
                            class="form-select">

                            <option
                                value="multiple-choice"
                                {{#ifEquals question.type 'multiple-choice'}}selected{{/ifEquals}}>
                                اختيار من متعدد
                            </option>

                            <option
                                value="true-false"
                                {{#ifEquals question.type 'true-false'}}selected{{/ifEquals}}>
                                صح / خطأ
                            </option>

                            <option
                                value="essay"
                                {{#ifEquals question.type 'essay'}}selected{{/ifEquals}}>
                                مقالي
                            </option>

                            <option
                                value="drawing"
                                {{#ifEquals question.type 'drawing'}}selected{{/ifEquals}}>
                                رسم
                            </option>

                            <option
                                value="correction"
                                {{#ifEquals question.type 'correction'}}selected{{/ifEquals}}>
                                صوّب ما تحته خط
                            </option>

                            <option
                                value="scientific-term"
                                {{#ifEquals question.type 'scientific-term'}}selected{{/ifEquals}}>
                                اكتب المصطلح العلمي
                            </option>

                            <option
                                value="complete"
                                {{#ifEquals question.type 'complete'}}selected{{/ifEquals}}>
                                أكمل الإجابة الصحيحة
                            </option>

                        </select>

                    </div>


                    <!-- ========================= -->
                    <!-- نص السؤال -->
                    <!-- ========================= -->

                    <div class="mb-4">

                        <label class="form-label">
                            نص السؤال
                        </label>

                        <textarea
                            name="questionText"
                            id="questionText"
                            class="form-control"
                            rows="4"
                            placeholder="اكتبي نص السؤال هنا..."
                            required>{{question.questionText}}</textarea>

                    </div>


                    <!-- ========================= -->
                    <!-- تحديد الكلمة المراد تصويبها -->
                    <!-- ========================= -->

                    <div
                        id="correctionWordSection"
                        class="mb-4"
                        style="display: none;">

                        <div class="border rounded p-3">

                            <h6 class="fw-bold mb-3">
                                تحديد الكلمة المراد تصويبها
                            </h6>

                            <p class="text-muted mb-3">

                                ظللي الكلمة داخل نص السؤال بالماوس،
                                ثم اضغطي على الزر.

                            </p>


                            <button
                                type="button"
                                class="btn btn-outline-primary"
                                id="selectCorrectionWord">

                                ✏️ تحديد الكلمة بالماوس

                            </button>


                            <div
                                id="selectedCorrectionWord"
                                class="mt-3 fw-bold text-success">

                                {{#if question.underlinedText}}
                                    الكلمة المحددة:
                                    {{question.underlinedText}}
                                {{/if}}

                            </div>


                          <input
                                type="hidden"
                                name="underlinedText"
                                id="underlinedText"
                                value="{{question.underlinedText}}">


                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- الاختيارات -->
                    <!-- ========================= -->

                    <div id="multipleChoiceSection">

                        <label class="form-label">
                            الاختيارات
                        </label>


                        <!-- الاختيار الأول -->

                        <div class="input-group mb-2">

                            <div class="input-group-text">

                                <input
                                    type="radio"
                                    name="correctAnswer"
                                    data-option-index="0"
                                    {{#ifEquals question.correctAnswer question.options.[0]}}checked{{/ifEquals}}>

                            </div>

                            <input
                                type="text"
                                class="form-control"
                                name="options"
                                value="{{question.options.[0]}}"
                                placeholder="الاختيار الأول">

                        </div>


                        <!-- الاختيار الثاني -->

                        <div class="input-group mb-2">

                            <div class="input-group-text">

                                <input
                                    type="radio"
                                    name="correctAnswer"
                                    data-option-index="1"
                                    {{#ifEquals question.correctAnswer question.options.[1]}}checked{{/ifEquals}}>

                            </div>

                            <input
                                type="text"
                                class="form-control"
                                name="options"
                                value="{{question.options.[1]}}"
                                placeholder="الاختيار الثاني">

                        </div>


                        <!-- الاختيار الثالث -->

                        <div class="input-group mb-2">

                            <div class="input-group-text">

                                <input
                                    type="radio"
                                    name="correctAnswer"
                                    data-option-index="2"
                                    {{#ifEquals question.correctAnswer question.options.[2]}}checked{{/ifEquals}}>

                            </div>

                            <input
                                type="text"
                                class="form-control"
                                name="options"
                                value="{{question.options.[2]}}"
                                placeholder="الاختيار الثالث">

                        </div>


                        <!-- الاختيار الرابع -->

                        <div class="input-group mb-3">

                            <div class="input-group-text">

                                <input
                                    type="radio"
                                    name="correctAnswer"
                                    data-option-index="3"
                                    {{#ifEquals question.correctAnswer question.options.[3]}}checked{{/ifEquals}}>

                            </div>

                            <input
                                type="text"
                                class="form-control"
                                name="options"
                                value="{{question.options.[3]}}"
                                placeholder="الاختيار الرابع">

                        </div>


                        <small class="text-muted">
                            اختاري الدائرة بجوار الإجابة الصحيحة.
                        </small>

                    </div>


                    <!-- ========================= -->
                    <!-- صح وخطأ -->
                    <!-- ========================= -->

                    <div
                        id="trueFalseSection"
                        class="mb-4"
                        style="display: none;">

                        <label class="form-label">
                            الإجابة الصحيحة
                        </label>


                        <div>

                            <div class="form-check form-check-inline">

                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="correctAnswer"
                                    value="صح"
                                    {{#ifEquals question.correctAnswer 'صح'}}checked{{/ifEquals}}>

                                <label class="form-check-label">
                                    صح
                                </label>

                            </div>


                            <div class="form-check form-check-inline">

                                <input
                                    class="form-check-input"
                                    type="radio"
                                    name="correctAnswer"
                                    value="خطأ"
                                    {{#ifEquals question.correctAnswer 'خطأ'}}checked{{/ifEquals}}>

                                <label class="form-check-label">
                                    خطأ
                                </label>

                            </div>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- الإجابة النموذجية للمقالي -->
                    <!-- ========================= -->

                    <div
                        id="essaySection"
                        class="mb-4"
                        style="display: none;">

                        <label class="form-label">

                            الإجابة النموذجية

                            <span class="text-muted">
                                (اختياري)
                            </span>

                        </label>

                        <textarea
                            name="modelAnswer"
                            class="form-control"
                            rows="5"
                            placeholder="اكتبي الإجابة النموذجية هنا...">{{question.modelAnswer}}</textarea>

                    </div>


                    <!-- ========================= -->
                    <!-- الرسم -->
                    <!-- ========================= -->

                    <div
                        id="drawingSection"
                        class="mb-4"
                        style="display: none;">

                        <div class="border rounded p-3">

                            <h5 class="mb-3">
                                إعداد سؤال الرسم
                            </h5>


                            <p class="text-muted">
                                حدد طريقة إجابة الطالب:
                            </p>


                            <div class="mb-4">

                                <div class="form-check mb-2">

                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        name="answerMode"
                                        value="text"
                                        id="answerModeText"
                                        {{#ifEquals question.answerMode 'text'}}checked{{/ifEquals}}>

                                    <label
                                        class="form-check-label"
                                        for="answerModeText">

                                        إجابة نصية فقط

                                    </label>

                                </div>


                                <div class="form-check mb-2">

                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        name="answerMode"
                                        value="drawing"
                                        id="answerModeDrawing"
                                        {{#ifEquals question.answerMode 'drawing'}}checked{{/ifEquals}}>

                                    <label
                                        class="form-check-label"
                                        for="answerModeDrawing">

                                        إجابة بالرسم فقط

                                    </label>

                                </div>


                                <div class="form-check">

                                    <input
                                        class="form-check-input"
                                        type="radio"
                                        name="answerMode"
                                        value="both"
                                        id="answerModeBoth"
                                        {{#ifEquals question.answerMode 'both'}}checked{{/ifEquals}}>

                                    <label
                                        class="form-check-label"
                                        for="answerModeBoth">

                                        إجابة نصية ورسم

                                    </label>

                                </div>

                            </div>


                            <p class="text-muted">
                                يمكنك رفع صورة ثم الرسم عليها، أو الرسم مباشرة.
                            </p>


                            <!-- أدوات الرسم -->

                            <div class="mb-3">

                                <button
                                    type="button"
                                    class="btn btn-outline-dark"
                                    id="penTool">

                                    ✏️ قلم

                                </button>


                                <button
                                    type="button"
                                    class="btn btn-outline-secondary"
                                    id="eraserTool">

                                    🧽 ممحاة

                                </button>


                                <select
                                    id="eraserSize"
                                    class="form-select d-inline-block"
                                    style="width: 150px;">

                                    <option value="10">
                                        ممحاة صغيرة
                                    </option>

                                    <option
                                        value="20"
                                        selected>

                                        ممحاة متوسطة

                                    </option>

                                    <option value="35">
                                        ممحاة كبيرة
                                    </option>

                                </select>


                                <button
                                    type="button"
                                    class="btn btn-secondary"
                                    id="clearDrawing">

                                    🧹 مسح الرسم

                                </button>


                                <label
                                    for="drawingImage"
                                    class="btn btn-primary">

                                    🖼️ رفع صورة

                                </label>


                                <input
                                    type="file"
                                    id="drawingImage"
                                    name="drawingImage"
                                    accept="image/*"
                                    style="display: none;">

                            </div>


                            <!-- مساحة الرسم -->

                            <div
                                class="border rounded"
                                style="
                                    background-color: white;
                                    overflow: hidden;
                                ">

                                <canvas
                                    id="drawingCanvas"
                                    width="800"
                                    height="400"
                                    style="
                                        width: 100%;
                                        height: auto;
                                        display: block;
                                        touch-action: none;
                                        cursor: crosshair;
                                    ">
                                </canvas>

                            </div>


                            <small class="text-muted d-block mt-2">

                                يمكنك الرسم باستخدام الماوس أو اللمس،
                                ويمكنك أيضًا رفع صورة والرسم فوقها.

                            </small>

                        </div>

                    </div>


                    <!-- ========================= -->
                    <!-- الإجابة الصحيحة للأنواع الجديدة -->
                    <!-- ========================= -->

                    <div
                        id="textQuestionSection"
                        class="mb-4"
                        style="display: none;">

                        <label class="form-label">
                            الإجابة الصحيحة
                        </label>


                        <textarea
                            name="correctAnswer"
                            id="textCorrectAnswer"
                            class="form-control"
                            rows="4"
                            placeholder="اكتبي الإجابة الصحيحة هنا...">{{question.correctAnswer}}</textarea>

                    </div>


                    <!-- ========================= -->
                    <!-- درجة السؤال -->
                    <!-- ========================= -->

                    <div class="mb-4">

                        <label class="form-label">
                            درجة السؤال
                        </label>

                        <input
                            value="{{question.marks}}"
                            type="number"
                            name="marks"
                            class="form-control"
                            min="1"
                            placeholder="مثال: 2"
                            required>

                    </div>


                    <!-- ========================= -->
                    <!-- أزرار -->
                    <!-- ========================= -->

                    <div class="d-flex justify-content-between">

                        <a
                            href="/questions/{{exam._id}}"
                            class="btn btn-secondary">

                            إلغاء

                        </a>


                        <button
                            type="submit"
                            class="btn btn-primary">

                            حفظ السؤال

                        </button>

                    </div>


                </form>

            </div>

        </div>

    </div>
</div>


<script src="/javascripts/add-question.js"></script>


<!-- ========================= -->
<!-- تحديد كلمة التصويب -->
<!-- ========================= -->

<script>

(function () {

    console.log('CORRECTION WORD SCRIPT STARTED');


    const correctionTypeSelect =
        document.getElementById('questionType');

    const correctionWordSection =
        document.getElementById('correctionWordSection');

    const questionTextInput =
        document.getElementById('questionText');

    const selectCorrectionWordButton =
        document.getElementById('selectCorrectionWord');

    const underlinedTextInput =
        document.getElementById('underlinedText');

    const selectedCorrectionWord =
        document.getElementById('selectedCorrectionWord');


    console.log(
        'questionText:',
        questionTextInput
    );

    console.log(
        'selectCorrectionWord:',
        selectCorrectionWordButton
    );

    console.log(
        'underlinedText:',
        underlinedTextInput
    );


    // التأكد من وجود العناصر

    if (
        !correctionTypeSelect ||
        !correctionWordSection ||
        !questionTextInput ||
        !selectCorrectionWordButton ||
        !underlinedTextInput ||
        !selectedCorrectionWord
    ) {

        console.error(
            '❌ عناصر تحديد كلمة التصويب غير موجودة'
        );

        return;

    }


    // إظهار وإخفاء قسم تحديد الكلمة

    function updateCorrectionWordSection() {

        if (
            correctionTypeSelect.value === 'correction'
        ) {

            correctionWordSection.style.display =
                'block';

        } else {

            correctionWordSection.style.display =
                'none';

        }

    }


    // عند فتح الصفحة

    updateCorrectionWordSection();


    // عند تغيير نوع السؤال

    correctionTypeSelect.addEventListener(
        'change',
        updateCorrectionWordSection
    );


    // تحديد الكلمة

    selectCorrectionWordButton.addEventListener(
        'click',
        function () {

            console.log(
                '🟢 زر تحديد الكلمة تم الضغط عليه'
            );


            const start =
                questionTextInput.selectionStart;

            const end =
                questionTextInput.selectionEnd;


            console.log(
                'START:',
                start,
                'END:',
                end
            );


            if (start === end) {

                alert(
                    'من فضلك ظللي الكلمة المراد تصويبها بالماوس أولًا.'
                );

                return;

            }


            const selectedText =
                questionTextInput.value.substring(
                    start,
                    end
                ).trim();


            console.log(
                '🟢 UNDERLINED TEXT:',
                selectedText
            );


            // حفظ الكلمة في hidden input

            underlinedTextInput.value =
                selectedText;


            console.log(
                '🟢 HIDDEN INPUT VALUE:',
                underlinedTextInput.value
            );


            // عرض الكلمة المحددة

            selectedCorrectionWord.innerHTML =
                'الكلمة المحددة: ' +

                '<span class="text-decoration-underline text-success">' +

                selectedText +

                '</span>';

        }
    );


    // قبل إرسال الفورم

    const questionForm =
        document.getElementById('questionForm');


    if (questionForm) {

        questionForm.addEventListener(
            'submit',
            function () {

                console.log(
                    '🚀 FORM SUBMIT - UNDERLINED TEXT:',
                    underlinedTextInput.value
                );

            }
        );

    }

})();

</script>