<form action="/createAcount-exam-system" method="POST">

  <div class="mb-4">
    <label for="teacherName" class="form-label">اسم المدرس بالكامل</label>
    <input
      type="text"
      class="form-control"
      id="teacherName"
      name="teacherName"
      required
    >
  </div>

  <div class="mb-4">
    <label for="teacherPhone" class="form-label">رقم الهاتف</label>
    <input
      type="text"
      class="form-control"
      id="teacherPhone"
      name="teacherPhone"
      required
    >
  </div>

  <div class="mb-4">
    <label for="password" class="form-label">كلمة المرور</label>
    <input
      type="password"
      class="form-control"
      id="password"
      name="password"
      required
    >
  </div>

  <button type="submit" class="btn btn-primary">
    حفظ البيانات
  </button>

</form>