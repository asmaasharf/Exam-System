

<div class="row justify-content-center">

    <div class="col-lg-8">

        <div class="card shadow">

            <div class="card-header text-center">

                <h3>
                    {{exam.title}}
                </h3>

                <p class="text-muted mb-0">
                    بيانات الامتحان
                </p>

            </div>


            <div class="card-body">

                <div class="row text-center">

                    <div class="col-md-6 mb-4">

                        <strong>
                            المادة
                        </strong>

                        <div>
                            {{exam.subject}}
                        </div>

                    </div>


                    <div class="col-md-6 mb-4">

                        <strong>
                            الصف
                        </strong>

                        <div>
                            {{exam.grade}}
                        </div>

                    </div>


                    <div class="col-md-6 mb-4">

                        <strong>
                            مدة الامتحان
                        </strong>

                        <div>
                            {{exam.duration}} دقيقة
                        </div>

                    </div>


                    <div class="col-md-6 mb-4">

                        <strong>
                            عدد الأسئلة
                        </strong>

                        <div>
                            {{questions.length}}
                        </div>

                    </div>


                    <div class="col-md-6 mb-4">

                        <strong>
                            الدرجة النهائية
                        </strong>

                        <div>
                            {{exam.totalMarks}}
                        </div>

                    </div>


                    <div class="col-md-6 mb-4">

                        <strong>
                            نوع الامتحان
                        </strong>

                        <div>
                            {{exam.examType}}
                        </div>

                    </div>

                </div>


                <hr>


                <div class="alert alert-warning text-center">

                    <strong>
                        تنبيه
                    </strong>

                    <p class="mb-0 mt-2">
                        بمجرد الضغط على "بدء الامتحان" يبدأ احتساب الوقت.
                    </p>

                </div>


                <!-- بيانات الطالب -->

                <form
                    action="/exam/start/{{exam._id}}"
                    method="post">

                    <div class="mb-4">

                        <label class="form-label">
                            اسم الطالب
                        </label>

                        <input
                            type="text"
                            name="studentName"
                            class="form-control"
                            placeholder="اكتب اسمك"
                            required>

                    </div>


                    <div class="text-center">

                        <button
                            type="submit"
                            class="btn btn-primary btn-lg">

                            بدء الامتحان

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>