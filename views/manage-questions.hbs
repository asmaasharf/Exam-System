<!-- تنسيق الخط أسفل الكلمة المحددة -->

<!-- ================================================= -->

<style>

.correction-underline {

    position: relative;

    display: inline-block;

}


.correction-underline::after {

    content: "";

    position: absolute;

    left: 0;

    right: 0;

    top: calc(100% + 10px);

    height: 3px;

    background-color: black;

}


.correction-question {

    font-size: 1.05rem;

}


</style>

<script src="/javascripts/add-question.js"></script>

<script>

document.addEventListener('DOMContentLoaded', function () {


    /* ================================================= */
    /* إظهار الخط أسفل الكلمة المحددة في سؤال التصويب */
    /* ================================================= */

    const correctionQuestions =
        document.querySelectorAll(
            '.correction-question'
        );


    correctionQuestions.forEach(
        function (questionElement) {


            const questionText =
                questionElement.dataset.questionText || '';


            const underlinedText =
                questionElement.dataset.underlinedText || '';


            const textContainer =
                questionElement.querySelector(
                    '.question-text'
                );


            if (
                !textContainer ||
                !underlinedText
            ) {

                return;

            }


            const index =
                questionText.indexOf(
                    underlinedText
                );


            if (index === -1) {

                return;

            }


            textContainer.innerHTML = '';


            /* الجزء قبل الكلمة */

            textContainer.appendChild(

                document.createTextNode(

                    questionText.substring(
                        0,
                        index
                    )

                )

            );


            /* الكلمة المحددة */

            const underline =
                document.createElement('span');


            underline.textContent =
                underlinedText;


            underline.className =
                'correction-underline';


            textContainer.appendChild(
                underline
            );


            /* الجزء بعد الكلمة */

            textContainer.appendChild(

                document.createTextNode(

                    questionText.substring(

                        index +
                        underlinedText.length

                    )

                )

            );

        }
    );



    /* ================================================= */
    /* نسخ رابط الامتحان */
    /* ================================================= */

    const copyExamLink =
        document.getElementById(
            'copyExamLink'
        );


    if (!copyExamLink) {

        return;

    }


    copyExamLink.addEventListener(
        'click',
        async function () {


            const examId =
                this.dataset.examId;


            const examLink =
                `${window.location.origin}/exam/${examId}`;


            try {


                await navigator.clipboard.writeText(
                    examLink
                );


                const originalText =
                    this.innerHTML;


                this.innerHTML =
                    '✅ تم نسخ الرابط';


                setTimeout(
                    () => {

                        this.innerHTML =
                            originalText;

                    },
                    2000
                );


            }
            catch (error) {


                console.log(
                    'Copy Error:',
                    error
                );


                /* طريقة بديلة للمتصفحات */

                const tempInput =
                    document.createElement(
                        'input'
                    );


                tempInput.value =
                    examLink;


                document.body.appendChild(
                    tempInput
                );


                tempInput.select();


                tempInput.setSelectionRange(
                    0,
                    99999
                );


                document.execCommand(
                    'copy'
                );


                document.body.removeChild(
                    tempInput
                );


                const originalText =
                    this.innerHTML;


                this.innerHTML =
                    '✅ تم نسخ الرابط';


                setTimeout(
                    () => {

                        this.innerHTML =
                            originalText;

                    },
                    2000
                );

            }

        }
    );

});

</script>
